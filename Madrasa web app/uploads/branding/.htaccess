# Disable PHP execution and script engines in uploads directory
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|inc|cgi|pl|py|sh|bash)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
